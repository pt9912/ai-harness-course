.agents/
.claude/
.codex/
.tmp/

# Ausnahme: Agenten-Skills sind Repo-Werkzeug, keine Maschinen-Konfiguration —
# sie gehören zum Arbeiten an diesem Korpus und reisen deshalb mit. Der Rest von
# .claude/ (Sitzungs-, Rechte- und lokale Einstellungen) bleibt ignoriert.
!.claude/
.claude/*
!.claude/skills/
!.claude/skills/**

__pycache__/

# d-check.mk ist tool-generiert (`d-check --print-mk`) und tool-/versionsspezifisch.
# Die kanonische Kopie an der Kurs-Wurzel ist committet (das Kurs-Gate braucht sie
# auf jedem Checkout); die Template-Kopie wird NICHT mitgeliefert — der Adopter
# erzeugt sie beim Bootstrap (Modul 2). Kein committetes Duplikat, keine Drift.
/lab/templates/d-check.mk
